<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MBTI로 찾는 나의 포켓몬</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', 'Malgun Gothic', sans-serif;
        }

        body {
            background-color: #FFF9E6;
            color: #4A3E3D;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background-color: #FFFFFF;
            border: 4px solid #F6D55C;
            border-radius: 24px;
            width: 100%;
            max-width: 600px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 8px 24px rgba(246, 213, 92, 0.3);
        }

        h1 {
            font-size: 1.8rem;
            color: #D97706;
            margin-bottom: 12px;
        }

        p.subtitle {
            font-size: 1.1rem;
            color: #78350F;
            margin-bottom: 24px;
        }

        .mbti-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .mbti-btn {
            background-color: #FEF3C7;
            border: 2px solid #FDE68A;
            border-radius: 12px;
            padding: 14px 8px;
            font-size: 1rem;
            font-weight: bold;
            color: #92400E;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .mbti-btn:hover {
            background-color: #FDE68A;
            transform: translateY(-2px);
        }

        .result-card {
            display: none;
            background-color: #FFFBEB;
            border: 2px solid #FCD34D;
            border-radius: 20px;
            padding: 24px;
            margin-top: 10px;
        }

        .pokemon-emoji {
            font-size: 5rem;
            margin: 10px 0;
            line-height: 1;
        }

        .pokemon-name {
            font-size: 1.6rem;
            font-weight: bold;
            color: #B45309;
            margin-bottom: 16px;
        }

        .mbti-tag {
            display: inline-block;
            background-color: #F59E0B;
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            margin-bottom: 12px;
        }

        .description {
            font-size: 1.05rem;
            line-height: 1.6;
            color: #4A3E3D;
            margin-bottom: 20px;
            word-break: keep-all;
        }

        .match-box {
            background-color: #FEF3C7;
            border-radius: 12px;
            padding: 12px;
            font-size: 1rem;
            font-weight: bold;
            color: #92400E;
            margin-bottom: 20px;
        }

        .reset-btn {
            background-color: #F59E0B;
            color: white;
            border: none;
            border-radius: 12px;
            padding: 12px 28px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .reset-btn:hover {
            background-color: #D97706;
        }

        @media (max-width: 480px) {
            .mbti-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .container {
                padding: 20px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <div id="selection-screen">
        <h1>⚡ MBTI로 찾는 나의 포켓몬 ⚡</h1>
        <p class="subtitle">당신의 MBTI 유형을 선택해 보세요!</p>
        <div class="mbti-grid" id="mbti-grid"></div>
    </div>

    <div id="result-screen" class="result-card">
        <span class="mbti-tag" id="res-mbti"></span>
        <div class="pokemon-emoji" id="res-emoji"></div>
        <div class="pokemon-name" id="res-name"></div>
        <p class="description" id="res-desc"></p>
        <div class="match-box" id="res-match"></div>
        <button class="reset-btn" onclick="resetSelection()">다시 고르기</button>
    </div>
</div>

<script>
    const pokemonData = {
        "ISTJ": { name: "거북왕", emoji: "🐢", desc: "책임감이 강하고 규칙을 철저히 지키는 단단한 스타일입니다. 조용하지만 신뢰감이 높으며 항상 묵묵히 자신의 역할을 완벽하게 수행합니다.", match: "ENFP" },
        "ISFJ": { name: "해피너스", emoji: "🥚", desc: "타인을 돕고 챙기는 것을 좋아하는 상냥하고 따뜻한 성격입니다. 주변 사람들의 행복을 최우선으로 생각하며 든든한 버팀목이 되어줍니다.", match: "ENTP" },
        "INFJ": { name: "가디안", emoji: "🧚‍♀️", desc: "깊은 통찰력과 따뜻한 마음을 지닌 영혼의 수호자입니다. 상대방의 감정을 잘 이해하며 세상을 더 나은 곳으로 만들고자 합니다.", match: "ENFP" },
        "INTJ": { name: "뮤츠", emoji: "🔮", desc: "철저한 계획과 뛰어난 지성을 바탕으로 문제를 해결하는 전략가입니다. 독립적이고 주관이 뚜렷하며 완벽한 결과를 추구합니다.", match: "ENTP" },
        "ISTP": { name: "루카리오", emoji: "🐺", desc: "상황 판단력이 빠르고 도구나 기술을 다루는 데 능숙한 실전파입니다. 과묵하지만 필요한 순간에 탁월한 해결책을 제시합니다.", match: "ESFP" },
        "ISFP": { name: "메타몽", emoji: "🫠", desc: "온화하고 유연하며 유유자적한 자유로운 영혼입니다. 어떠한 상황에도 적응을 잘하며 예술적인 감각과 높은 공감 능력을 가지고 있습니다.", match: "ESTJ" },
        "INFP": { name: "이브이", emoji: "🦊", desc: "무한한 가능성과 순수한 마음을 가진 낭만주의자입니다. 자신만의 세계관이 깊고 주변에 긍정적인 에너지를 은은하게 전합니다.", match: "ENTJ" },
        "INTP": { name: "후딘", emoji: "🥄", desc: "지적 호기심이 넘치고 논리적 분석을 즐기는 아이디어 파입니다. 복잡한 문제를 단순하게 풀어나가는 능력이 뛰어납니다.", match: "ENTJ" },
        "ESTP": { name: "피카츄", emoji: "⚡", desc: "에너지가 넘치고 모험을 즐기는 분위기 메이커입니다. 순발력이 뛰어나 직관적으로 상황을 해결하며 주변을 즐겁게 만듭니다.", match: "ISFJ" },
        "ESFP": { name: "푸린", emoji: "🎤", desc: "사람들의 시선을 즐기고 분위기를 띄우는 스타성을 지녔습니다. 사교적이고 다정하며 감 표현에 솔직하여 어디서나 사랑받습니다.", match: "ISTJ" },
        "ENFP": { name: "파이리", emoji: "🔥", desc: "열정적이고 호기심이 많아 항상 새로운 것에 도전하는 모험가입니다. 밝은 에너지를 발산하여 주변 사람들에게 영감을 줍니다.", match: "INTJ" },
        "ENTP": { name: "팬텀", emoji: "👻", desc: "재치 있고 창의적이며 독창적인 아이디어가 넘치는 영리한 장난꾸러기입니다. 지루함을 참지 못하고 늘 흥미로운 일을 찾아 나섭니다.", match: "INFJ" },
        "ESTJ": { name: "윈디", emoji: "🦁", desc: "리더십이 강하고 목표를 향해 과감하게 돌진하는 실행력의 대명사입니다. 공정하고 체계적인 진행을 선호하여 조직을 잘 이끕니다.", match: "INFP" },
        "ESFJ": { name: "피카츄 (친화형)", emoji: "💛", desc: "친절하고 사교적이며 분위기를 훈훈하게 만드는 인싸입니다. 주변을 꼼꼼하게 잘 챙기고 유대감을 중요하게 생각합니다.", match: "ISFP" },
        "ENFJ": { name: "망나뇽", emoji: "🐉", desc: "따뜻한 마음과 강한 리더십을 동시에 갖춘 조화로운 중재자입니다. 타인의 성장을 돕고 용기를 주는 힘을 가지고 있습니다.", match: "INTP" },
        "ENTJ": { name: "리자몽", emoji: "🐲", desc: "야망이 크고 단호한 결단력으로 목표를 완수하는 지도자 유형입니다. 당당한 카리스마로 자신과 팀을 정상으로 이끕니다.", match: "INFP" }
    };

    const grid = document.getElementById('mbti-grid');
    Object.keys(pokemonData).forEach(mbti => {
        const btn = document.createElement('button');
        btn.className = 'mbti-btn';
        btn.innerText = mbti;
        btn.onclick = () => showResult(mbti);
        grid.appendChild(btn);
    });

    function showResult(mbti) {
        const data = pokemonData[mbti];
        document.getElementById('res-mbti').innerText = mbti;
        document.getElementById('res-emoji').innerText = data.emoji;
        document.getElementById('res-name').innerText = data.name;
        document.getElementById('res-desc').innerText = data.desc;
        document.getElementById('res-match').innerText = `✨ 환상의 짝꿍 유형: ${data.match}`;

        document.getElementById('selection-screen').style.display = 'none';
        document.getElementById('result-screen').style.display = 'block';
    }

    function resetSelection() {
        document.getElementById('selection-screen').style.display = 'block';
        document.getElementById('result-screen').style.display = 'none';
    }
</script>

</body>
</html>
